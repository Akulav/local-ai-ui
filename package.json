    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1",
    "vendor": "node scripts/vendor.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.3"
  }
}
