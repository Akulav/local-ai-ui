{
  "name": "lumen",
  "version": "0.8.0",
  "private": true,
  "description": "Lumen - hassle-free local AI (Tauri + Rust + llama.cpp)",
  "author": "Akulav",
  "scripts": {
    "build": "tauri build --no-bundle",
    "build:installer": "tauri build",
