{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumen",
  "version": "../package.json",
  "identifier": "com.akulav.lumen",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lumen",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0d0f14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Akulav",
    "copyright": "Made by Akulav",
    "category": "Productivity",
    "shortDescription": "Lumen - local AI",
    "longDescription": "Chat with local language models on your own PC. Nothing leaves the computer.",
    "homepage": "https://github.com/Akulav/local-ai-ui",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
